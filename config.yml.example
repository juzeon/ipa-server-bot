# Bot token from @BotFather
token: "YOUR_BOT_TOKEN"

# Application identity from https://my.telegram.org
api_id: 123456
api_hash: "YOUR_API_HASH"

# MTProto session. Relative paths are relative to the process working directory.
session_file: "./bot.bbolt"

# Configure your s3 here
s3:
  access_key_id: "YOUR_ACCESS_KEY_ID"
  secret_access_key: "YOUR_SECRET_ACCESS_KEY"
  endpoint: "YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
  bucket: "bucketName"
  region: "auto"
  url: "https://YOUR_PUBLIC_BUCKET_HOST"
